# Public URL used by the staging browser test environment.
# Example: https://dev.petrichor.example.com
STAGING_ORIGIN=

# TURN settings are required by coturn/server in compose.yaml.
TURN_EXTERNAL_IP=
TURN_SECRET=
TURN_REALM=turn.example.com
TURN_CERT_DIR=/etc/letsencrypt/live/turn.example.com
TURN_CERT_ARCHIVE_DIR=/etc/letsencrypt/archive/turn.example.com

# Server auth/database settings.
JWT_SECRET=
PETRICHOR_DATABASE_PATH=/app/data/petrichor.db

# Leave these empty for same-origin staging.
WORLD_WS_ORIGIN=
ICE_API_ORIGIN=
